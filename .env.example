# flows_dev settings. setup.ps1 creates .env in the install folder; environment variables override it, and
# Metronome's own settings file (DG_ENV_FILE) fills in anything not set here. Names match Metronome's. Never commit .env.

# Optional GitHub token for setup.ps1 (Contents: read). Same token as Metronome.
# DG_GITHUB_TOKEN=

# Metronome's settings file. setup.ps1 finds it through the MXAnalytics service; leave the value empty to ignore it.
# DG_ENV_FILE=C:\Metronome\.env

# Metronome's Flow browser profile (portal sessions and .asap_credentials). Default: %USERPROFILE%\.metronome-flow-browser
# METRONOME_FLOW_PROFILE=
